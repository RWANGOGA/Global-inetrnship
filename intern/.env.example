# Base URL of the FastAPI backend (the mounted feature sub-app lives under /api).
# Leave empty to use the bundled seed (this is what the static GitHub Pages
# build does). Set it to hit the real database, e.g. local dev:
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_API_BASE_URL=https://global-inetrnship.onrender.com/api

# DeepL API key for voice features (TTS/STT).
# Get your key from https://www.deepl.com/pro-api
NEXT_PUBLIC_DEEPL_API_KEY=
