# Template only — safe to commit. Do NOT put real secrets here.
# Copy to .env.local (git-ignored) and put your values there:
#   cp .env.example .env.local
APP_NAME=BrighterWorks API
ENVIRONMENT=development

# Postgres in Docker for local dev. Later: point at Neon (just change this URL).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/intern

# Groq advisor (B3). Fill these in .env.local — never commit a real key.
# The model is intentionally left unset here; choose it in your .env.local.
GROQ_API_KEY=
GROQ_MODEL=

# DeepL voice (TTS/STT). Fill in .env.local — never commit a real key.
DEEPL_API_KEY=

# Seed data credentials (used by seed_if_empty on startup).
# Set these in .env.local for production deployments.
# DEMO_PASSWORD=password123
# ADMIN_PASSWORD=your-strong-password-here
# ADMIN_EMAIL=admin@yourdomain.com
